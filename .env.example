# Environment Variables Template
# Copy this file to .env and fill in your actual API keys.
# .env is ignored by git and will never be committed.

# ── Teacher Model APIs (Phase 1: Dataset Generation) ──────────────────────────
# Required for generating training data (gemini-1.5-pro)
GEMINI_API_KEY=your_gemini_api_key_here

# Required for generating independent sealed eval set (claude-3-5-sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Gateway / Cloud Routing (Phase 2) ─────────────────────────────────────────
# Required for routing sanitized queries to cloud LLMs
AIPIPE_API_KEY=your_aipipe_api_key_here
AIPIPE_BASE_URL=https://aipipe.org/openrouter/v1
OPENAI_API_KEY=your_openai_api_key_here

# ── Optional: Experiment Tracking ─────────────────────────────────────────────
# WANDB_API_KEY=your_wandb_key_here
# HF_TOKEN=your_huggingface_write_token_here
